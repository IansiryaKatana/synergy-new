# Root-level Apache config mirror for hosts that read .htaccess from project root.
# Authoritative copy lives in public/.htaccess (deployed to dist root).

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>
